<Window x:Class="FreeTrainSimulator.Toolbox.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:avalonLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:host="clr-namespace:FreeTrainSimulator.Toolbox.Hosting"
        xmlns:viewModels="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
        mc:Ignorable="d"
        Title="Free Train Simulator Toolbox"
        Width="1400"
        Height="900"
        MinWidth="1024"
        MinHeight="720">
    <Window.Resources>
        <viewModels:DrawingColorToBrushConverter x:Key="DrawingColorToBrushConverter" />
        <viewModels:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        <viewModels:ColorNameToBrushConverter x:Key="ColorNameToBrushConverter" />
        <Style x:Key="ToolWindowRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground"
                    Value="{Binding Color, Converter={StaticResource DrawingColorToBrushConverter}}" />
            <Setter Property="FontWeight"
                    Value="{Binding Bold, Converter={StaticResource BoolToFontWeightConverter}}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="MainMenu"
              DockPanel.Dock="Top"
              DataContext="{Binding Menu}"
              IsEnabled="{Binding Enabled}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Route"
                          Command="{Binding DataContext.ShowRouteToolCommand, ElementName=RootWindow}" />
                <Separator />
                <MenuItem Header="Take _Screenshot" Command="{Binding TakeScreenshotCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding QuitCommand}" />
            </MenuItem>
            <MenuItem Header="_Paths">
                <MenuItem x:Name="LoadPathMenu"
                          Header="_Load Path"
                          ItemsSource="{Binding Paths}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding DataContext.TogglePathCommand, ElementName=MainMenu}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_New Path" Command="{Binding EditPathCommand}" />
                <MenuItem Header="_Save Path" Command="{Binding SavePathCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Routes"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsRouteToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleRouteToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="_Location Window"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsLocationToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleLocationToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="_Debug Window"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsDebugToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleDebugToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="Lo_g Window"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsLogToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleLogToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="Track _Item Information"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsTrackItemInfoToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleTrackItemInfoToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="Track _Node Information"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsTrackNodeInfoToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleTrackNodeInfoToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="_Help Window"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsHelpToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleHelpToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="_Settings Window"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsSettingsToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleSettingsToolCommand, ElementName=RootWindow}" />
                <MenuItem Header="Train _Path Details"
                          IsCheckable="True"
                          IsChecked="{Binding DataContext.IsTrainPathToolVisible, ElementName=RootWindow, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleTrainPathToolCommand, ElementName=RootWindow}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>
        <Grid>
            <avalonDock:DockingManager x:Name="DockingManager">
                <avalonLayout:LayoutRoot>
                    <avalonLayout:LayoutPanel Orientation="Horizontal">
                        <avalonLayout:LayoutDocumentPane>
                            <avalonLayout:LayoutDocument Title="Map View"
                                                        ContentId="MapViewDocument"
                                                        CanFloat="False"
                                                        CanClose="False">
                                <host:ToolboxGameHostControl x:Name="MapHost" />
                            </avalonLayout:LayoutDocument>
                        </avalonLayout:LayoutDocumentPane>
                        <avalonLayout:LayoutAnchorablePane DockWidth="340">
                            <avalonLayout:LayoutAnchorable x:Name="RouteToolAnchorable"
                                                          ContentId="RouteToolWindow"
                                                          Title="Routes"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="360"
                                                          FloatingHeight="420"
                                                          IsSelected="True">
                                <StackPanel Margin="6"
                                            DataContext="{Binding DataContext.Menu, ElementName=RootWindow}"
                                            IsEnabled="{Binding Enabled}">
                                    <TextBlock Text="Content Folder"
                                               Margin="0,0,0,3" />
                                    <ComboBox Margin="0,0,0,9"
                                              ItemsSource="{Binding ContentFolders}"
                                              SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              ToolTip="Select the content folder to load routes from" />
                                    <TextBlock Text="Route"
                                               Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding Routes}"
                                              SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              ToolTip="Select a route to open" />
                                </StackPanel>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="LocationToolAnchorable"
                                                          ContentId="LocationToolWindow"
                                                          Title="Location"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="520"
                                                          FloatingHeight="440"
                                                          IsSelected="False">
                                <ListView Margin="6"
                                          ItemsSource="{Binding DataContext.LocationTool.Rows, ElementName=RootWindow}"
                                          ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Value" Width="320" DisplayMemberBinding="{Binding Value}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="DebugToolAnchorable"
                                                          ContentId="DebugToolWindow"
                                                          Title="Debug Information"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="520"
                                                          FloatingHeight="480"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <ListView Margin="6"
                                          ItemsSource="{Binding DataContext.DebugTool.Rows, ElementName=RootWindow}"
                                          ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Value" Width="320" DisplayMemberBinding="{Binding Value}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="LogToolAnchorable"
                                                          ContentId="LogToolWindow"
                                                          Title="Logging"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="720"
                                                          FloatingHeight="440"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <TextBox x:Name="LogTextBox"
                                         Margin="6"
                                         Text="{Binding DataContext.LogTool.LogText, ElementName=RootWindow, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False"
                                         FontFamily="Consolas"
                                         TextWrapping="NoWrap"
                                         TextChanged="LogTextBox_TextChanged"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="TrackItemInfoToolAnchorable"
                                                          ContentId="TrackItemInfoToolWindow"
                                                          Title="Track Item Information"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="520"
                                                          FloatingHeight="480"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <DockPanel Margin="6"
                                           DataContext="{Binding DataContext.TrackItemInfoTool, ElementName=RootWindow}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right"
                                                Margin="6,0,0,0"
                                                Padding="8,0"
                                                Content="Find"
                                                Command="{Binding SearchCommand}" />
                                        <TextBox VerticalContentAlignment="Center"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Find Track Item by Index">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <ListView ItemsSource="{Binding Rows}"
                                              ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Value" Width="320" DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="TrackNodeInfoToolAnchorable"
                                                          ContentId="TrackNodeInfoToolWindow"
                                                          Title="Track Node Information"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="520"
                                                          FloatingHeight="520"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <DockPanel Margin="6"
                                           DataContext="{Binding DataContext.TrackNodeInfoTool, ElementName=RootWindow}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right"
                                                Margin="6,0,0,0"
                                                Padding="8,0"
                                                Content="Find"
                                                Command="{Binding SearchCommand}" />
                                        <TextBox VerticalContentAlignment="Center"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Find Track Node by Index">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <RadioButton GroupName="TrackNodeSearchType"
                                                     Content="Tracks"
                                                     IsChecked="True" />
                                        <RadioButton GroupName="TrackNodeSearchType"
                                                     Margin="12,0,0,0"
                                                     Content="Roads"
                                                     IsChecked="{Binding SearchRoads}" />
                                    </StackPanel>
                                    <ListView ItemsSource="{Binding Rows}"
                                              ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Value" Width="320" DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="HelpToolAnchorable"
                                                          ContentId="HelpToolWindow"
                                                          Title="Help"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="480"
                                                          FloatingHeight="520"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <DockPanel Margin="6"
                                           DataContext="{Binding DataContext.HelpTool, ElementName=RootWindow}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBox VerticalContentAlignment="Center"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Search Help" />
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <RadioButton GroupName="HelpSearchType"
                                                     Content="Command"
                                                     IsChecked="True" />
                                        <RadioButton GroupName="HelpSearchType"
                                                     Margin="12,0,0,0"
                                                     Content="Key"
                                                     IsChecked="{Binding SearchByKey}" />
                                    </StackPanel>
                                    <ListView ItemsSource="{Binding Rows}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Command" Width="260" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Key" Width="180" DisplayMemberBinding="{Binding Value}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="SettingsToolAnchorable"
                                                          ContentId="SettingsToolWindow"
                                                          Title="Settings"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="480"
                                                          FloatingHeight="560"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <DockPanel Margin="6"
                                           DataContext="{Binding DataContext.SettingsTool, ElementName=RootWindow}">
                                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                        <Button HorizontalAlignment="Right"
                                                Padding="10,3"
                                                Content="Reset to Defaults"
                                                ToolTip="Reset window layout, colors, item visibility, and appearance options to their defaults"
                                                Command="{Binding DataContext.ResetSettingsCommand, ElementName=RootWindow}" />
                                    </Border>
                                    <TabControl>
                                        <TabItem Header="General">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="6">
                                                <GroupBox Header="Common" Padding="6" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <CheckBox Content="Enable Logging"
                                                                  Margin="0,3"
                                                                  IsChecked="{Binding EnableLogging}" />
                                                        <CheckBox Content="Restore Last View on Start"
                                                                  Margin="0,3"
                                                                  IsChecked="{Binding RestoreLastView}" />
                                                    </StackPanel>
                                                </GroupBox>
                                                <GroupBox Header="Graphics" Padding="6">
                                                    <StackPanel>
                                                        <CheckBox Content="Use Font Outline"
                                                                  Margin="0,3"
                                                                  IsChecked="{Binding FontOutline}" />
                                                        <CheckBox Content="Use Real Track Width"
                                                                  Margin="0,3"
                                                                  IsChecked="{Binding RealTrackWidth}" />
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Colors">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding ColorItems}" Margin="6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="140" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       VerticalAlignment="Center" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding AvailableColorNames}"
                                                                      SelectedItem="{Binding SelectedColorName}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Rectangle Width="14"
                                                                                       Height="14"
                                                                                       Margin="0,0,6,0"
                                                                                       Stroke="Gray"
                                                                                       StrokeThickness="1"
                                                                                       Fill="{Binding Converter={StaticResource ColorNameToBrushConverter}}" />
                                                                            <TextBlock Text="{Binding}"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Item Visibility">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="6">
                                                <Expander Header="Track Items" IsExpanded="True" Margin="0,2">
                                                    <ItemsControl ItemsSource="{Binding TrackVisibilityItems}" Margin="12,3,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Label}"
                                                                          Margin="0,2"
                                                                          IsChecked="{Binding IsVisible}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <Expander Header="Road Items" IsExpanded="True" Margin="0,2">
                                                    <ItemsControl ItemsSource="{Binding RoadVisibilityItems}" Margin="12,3,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Label}"
                                                                          Margin="0,2"
                                                                          IsChecked="{Binding IsVisible}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <Expander Header="Interactives" IsExpanded="True" Margin="0,2">
                                                    <ItemsControl ItemsSource="{Binding InteractiveVisibilityItems}" Margin="12,3,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Label}"
                                                                          Margin="0,2"
                                                                          IsChecked="{Binding IsVisible}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <ItemsControl ItemsSource="{Binding OtherVisibilityItems}" Margin="0,3,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}"
                                                                      Margin="0,2"
                                                                      IsChecked="{Binding IsVisible}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </avalonLayout:LayoutAnchorable>
                            <avalonLayout:LayoutAnchorable x:Name="TrainPathToolAnchorable"
                                                          ContentId="TrainPathToolWindow"
                                                          Title="Train Path Details"
                                                          CanClose="False"
                                                          CanHide="True"
                                                          FloatingWidth="520"
                                                          FloatingHeight="520"
                                                          IsVisible="False"
                                                          IsSelected="False">
                                <TabControl Margin="6"
                                            DataContext="{Binding DataContext.TrainPathTool, ElementName=RootWindow}">
                                    <TabItem Header="Path Nodes">
                                        <ListView ItemsSource="{Binding Nodes}"
                                                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Idx" Width="50" DisplayMemberBinding="{Binding Index}" />
                                                    <GridViewColumn Header="Type" Width="160" DisplayMemberBinding="{Binding NodeType}" />
                                                    <GridViewColumn Header="Valid" Width="60" DisplayMemberBinding="{Binding Valid}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </TabItem>
                                    <TabItem Header="Path Data">
                                        <ListView ItemsSource="{Binding Metadata}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Setting" Width="120" DisplayMemberBinding="{Binding Name}" />
                                                    <GridViewColumn Header="Value" Width="220" DisplayMemberBinding="{Binding Value}" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </TabItem>
                                    <TabItem Header="Paths">
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Top"
                                                     Margin="0,0,0,6"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Search Paths" />
                                            <TextBlock DockPanel.Dock="Bottom"
                                                       Margin="0,6,0,0"
                                                       Foreground="OrangeRed"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding StatusMessage}" />
                                            <ListView ItemsSource="{Binding Paths}"
                                                      SelectedItem="{Binding SelectedPath, Mode=TwoWay}">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding Name}" />
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </avalonLayout:LayoutAnchorable>
                        </avalonLayout:LayoutAnchorablePane>
                    </avalonLayout:LayoutPanel>
                </avalonLayout:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>
    </DockPanel>
</Window>
