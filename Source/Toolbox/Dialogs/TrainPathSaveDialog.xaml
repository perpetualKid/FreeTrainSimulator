<Window x:Class="FreeTrainSimulator.Toolbox.Dialogs.TrainPathSaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Train Path Meta Data"
        Width="380"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Path Name" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="6,4"
                 Text="{Binding PathName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Path ID" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="6,4"
                 Text="{Binding PathId, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Path Start" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="6,4"
                 Text="{Binding PathStart, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Path End" VerticalAlignment="Center" Margin="0,4" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="6,4"
                 Text="{Binding PathEnd, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Player Path" VerticalAlignment="Center" Margin="0,4" />
        <CheckBox Grid.Row="4" Grid.Column="1" Margin="6,4" VerticalAlignment="Center"
                  IsChecked="{Binding PlayerPath}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Text="{Binding IdentityMessage}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{Binding SaveActionText}"
                    Width="90"
                    IsDefault="True"
                    IsEnabled="{Binding CanSave}"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    Width="90"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
