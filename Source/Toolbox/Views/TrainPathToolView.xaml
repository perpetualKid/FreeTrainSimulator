<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.TrainPathToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             xmlns:behaviors="clr-namespace:FreeTrainSimulator.Toolbox.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrainPathToolWindowViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="520,520"
             d:DesignWidth="520"
             d:DesignHeight="520">
    <UserControl.Resources>
        <DataTemplate x:Key="TrainPathMetadataNameCellTemplate">
            <TextBlock Text="{Binding Name}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Padding" Value="4,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Bold}" Value="True">
                                <Setter Property="Padding" Value="0,2,0,2" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TrainPathMetadataValueCellTemplate">
            <Border BorderBrush="Gainsboro"
                    BorderThickness="1,0,0,0"
                    Margin="-6,0,0,0"
                    Padding="4,0,0,0">
                <TextBlock Text="{Binding Value}"
                           TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <Style x:Key="TrainPathMetadataRowItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource ToolWindowRowItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bold}" Value="True">
                    <Setter Property="Background" Value="#FFEFEFEF" />
                    <Setter Property="Padding" Value="0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TrainPathValidityCellTemplate">
            <TextBlock HorizontalAlignment="Center"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#x2013;" />
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="ToolTip" Value="Not yet validated" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationState}" Value="Valid">
                                <Setter Property="Text" Value="&#x2713;" />
                                <Setter Property="Foreground" Value="Green" />
                                <Setter Property="ToolTip" Value="Valid: resolves against the current track" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ValidationState}" Value="Invalid">
                                <Setter Property="Text" Value="&#x26A0;" />
                                <Setter Property="Foreground" Value="OrangeRed" />
                                <Setter Property="ToolTip" Value="Invalid: does not resolve against the current track" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <TabControl Margin="10"
                SelectedIndex="0">
        <TabItem Header="Paths"
                 IsSelected="True">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,6">
                    <Button Padding="8,2"
                            Margin="0,0,6,4"
                            Content="New Path"
                            Command="{Binding NewPathCommand}"
                            ToolTip="Start editing a new path for the current route" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Save Path"
                            Command="{Binding SavePathCommand}"
                            ToolTip="Save the currently edited path" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Validate All"
                            Command="{Binding ValidateAllPathsCommand}"
                            ToolTip="Re-validate every path against the current track (useful after a route changes)" />
                </WrapPanel>
                <TextBox Grid.Row="1"
                         Margin="0,0,0,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search Paths" />
                <ListView Grid.Row="2"
                          ItemsSource="{Binding Paths}"
                          SelectedItem="{Binding SelectedPath, Mode=TwoWay}"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="28" CellTemplate="{StaticResource TrainPathValidityCellTemplate}" />
                            <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding Name}"
                                            behaviors:GridViewColumnBehavior.StretchColumn="True" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="3"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <DockPanel Grid.Row="3" Margin="0,4,0,0" Grid.RowSpan="2">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,2,0,4"
                               FontWeight="Bold"
                               Text="Path Details" />
                    <ListView ItemsSource="{Binding Metadata}"
                              ItemContainerStyle="{StaticResource TrainPathMetadataRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              behaviors:GridViewColumnBehavior.EqualColumnWidth="True"
                              behaviors:GridViewColumnBehavior.StretchListView="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Setting" Width="250" CellTemplate="{StaticResource TrainPathMetadataNameCellTemplate}" />
                                <GridViewColumn Header="Value" Width="250" CellTemplate="{StaticResource TrainPathMetadataValueCellTemplate}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <TextBlock Grid.Row="5"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessageIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </TabItem>
        <TabItem Header="Path Nodes">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,6">
                    <Button Padding="8,2"
                            Margin="0,0,6,4"
                            Content="Undo"
                            Command="{Binding UndoCommand}" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Redo"
                            Command="{Binding RedoCommand}" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Move Node"
                            Command="{Binding MoveSelectedNodeCommand}"
                            ToolTip="Move the selected node to the next valid map location you click" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Cancel Move"
                            Command="{Binding CancelMoveNodeCommand}"
                            ToolTip="Cancel the active node move operation" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Repair Node"
                            Command="{Binding RepairSelectedNodeCommand}"
                            ToolTip="Safely repair the selected node when the fix is unambiguous, such as converting a non-junction junction marker into a track point" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Re-resolve Path"
                            Command="{Binding SnapToTrackCommand}"
                            ToolTip="Rebuild the whole path from its authored nodes using the path resolver. This may insert generated nodes and update links." />
                </WrapPanel>
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Validation}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Valid}" Value="False">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Idx" Width="50" DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding NodeType}" />
                            <GridViewColumn Header="Valid" Width="60" DisplayMemberBinding="{Binding Valid}" />
                            <GridViewColumn Header="Validation" Width="180" DisplayMemberBinding="{Binding Validation}"
                                            behaviors:GridViewColumnBehavior.StretchColumn="True" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,2,0,4"
                               FontWeight="Bold"
                               Text="Path Node Details" />
                    <ListView ItemsSource="{Binding SelectedNodeDetailRows}"
                              ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}"
                              behaviors:GridViewColumnBehavior.EqualColumnWidth="True"
                              behaviors:GridViewColumnBehavior.StretchListView="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="250" CellTemplate="{StaticResource ToolWindowNameCellTemplate}" />
                                <GridViewColumn Header="Value" Width="250" CellTemplate="{StaticResource ToolWindowValueCellTemplate}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
