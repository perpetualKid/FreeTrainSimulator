<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.TrainPathToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             xmlns:behaviors="clr-namespace:FreeTrainSimulator.Toolbox.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrainPathToolWindowViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="520,520"
             d:DesignWidth="520"
             d:DesignHeight="520">
    <TabControl Margin="6">
        <TabItem Header="Path Nodes">
            <ListView ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      behaviors:GridViewColumnBehavior.StretchListView="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Idx" Width="50" DisplayMemberBinding="{Binding Index}" />
                        <GridViewColumn Header="Type" Width="160" DisplayMemberBinding="{Binding NodeType}"
                                        behaviors:GridViewColumnBehavior.StretchColumn="True" />
                        <GridViewColumn Header="Valid" Width="60" DisplayMemberBinding="{Binding Valid}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>
        <TabItem Header="Path Data">
            <ListView ItemsSource="{Binding Metadata}"
                      behaviors:GridViewColumnBehavior.StretchListView="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Setting" Width="120" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Value" Width="220" DisplayMemberBinding="{Binding Value}"
                                        behaviors:GridViewColumnBehavior.StretchColumn="True" />
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>
        <TabItem Header="Paths">
            <DockPanel>
                <TextBox DockPanel.Dock="Top"
                         Margin="0,0,0,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search Paths" />
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,6,0,0"
                           Foreground="OrangeRed"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}" />
                <ListView ItemsSource="{Binding Paths}"
                          SelectedItem="{Binding SelectedPath, Mode=TwoWay}"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding Name}"
                                            behaviors:GridViewColumnBehavior.StretchColumn="True" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
