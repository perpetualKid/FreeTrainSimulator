<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.TrainPathToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             xmlns:behaviors="clr-namespace:FreeTrainSimulator.Toolbox.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrainPathToolWindowViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="520,520"
             d:DesignWidth="520"
             d:DesignHeight="520">
    <UserControl.Resources>
        <DataTemplate x:Key="TrainPathMetadataNameCellTemplate">
            <TextBlock Text="{Binding Name}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Padding" Value="4,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Bold}" Value="True">
                                <Setter Property="Padding" Value="0,2,0,2" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!-- The Wait row is the single editor for the wait time used by the map context menu. Other node
             properties remain read-only diagnostic values. -->
        <DataTemplate x:Key="TrainPathNodeDetailValueCellTemplate">
            <Border BorderBrush="Gainsboro"
                    BorderThickness="1,0,0,0"
                    Margin="-6,0,0,0">
                <!-- An empty TextBox otherwise measures to nearly zero width inside a GridView cell, making a
                     normal node's blank Wait value impossible to click. The minimum width gives the value cell
                     a stable property-grid editing surface even before it contains text. -->
                <Grid MinWidth="200">
                    <TextBlock Text="{Binding Value}"
                               Padding="4,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="Wait">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox MinWidth="200"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Padding="4,0"
                             MaxLength="10"
                             PreviewTextInput="WaitTimeTextBox_PreviewTextInput"
                             DataObject.Pasting="WaitTimeTextBox_Pasting"
                             Text="{Binding DataContext.SelectedNodeWaitTime, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Wait time in seconds. Enter a positive value to create or update a wait point; clear the value or enter zero to remove it.">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="Wait">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF007ACC" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <!-- Compensate for the focus border so the text does not move when editing. -->
                                        <Setter Property="Padding" Value="3,0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TrainPathMetadataValueCellTemplate">
            <Border BorderBrush="Gainsboro"
                    BorderThickness="1,0,0,0"
                    Margin="-6,0,0,0"
                    Padding="4,0,0,0">
                <TextBlock Text="{Binding Value}"
                           TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <Style x:Key="TrainPathMetadataRowItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource ToolWindowRowItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bold}" Value="True">
                    <Setter Property="Background" Value="#FFEFEFEF" />
                    <Setter Property="Padding" Value="0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TrainPathValidityCellTemplate">
            <TextBlock HorizontalAlignment="Center"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#x2013;" />
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="ToolTip" Value="Not yet validated" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationState}" Value="Valid">
                                <Setter Property="Text" Value="&#x2713;" />
                                <Setter Property="Foreground" Value="Green" />
                                <Setter Property="ToolTip" Value="Valid: resolves against the current track" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ValidationState}" Value="Invalid">
                                <Setter Property="Text" Value="&#x26A0;" />
                                <Setter Property="Foreground" Value="OrangeRed" />
                                <Setter Property="ToolTip" Value="Invalid: does not resolve against the current track" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!-- Paths with pending edits are marked with a trailing asterisk (announced by screen readers) and
             bold text (scannable at a glance). Italic is deliberately avoided: it conventionally denotes
             preview/temporary items rather than unsaved changes. -->
        <DataTemplate x:Key="TrainPathNameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" *"
                           FontWeight="Bold"
                           ToolTip="Unsaved changes">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <TabControl x:Name="PathEditorTabs"
                Margin="10"
                SelectionChanged="PathEditorTabs_SelectionChanged"
                SelectedIndex="{Binding SelectedTabIndex, Mode=OneWay}">
        <TabItem Header="Paths">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,6">
                    <Button Padding="8,2"
                            Margin="0,0,6,4"
                            Content="New Path"
                            Command="{Binding NewPathCommand}"
                             ToolTip="Start editing a new path for the current route">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCancelNewPath}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Padding="8,2"
                             Margin="0,0,6,4"
                             Content="Cancel New Path"
                             Command="{Binding CancelNewPathCommand}"
                             ToolTip="Cancel the active unsaved new path">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCancelNewPath}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Save Path"
                            Command="{Binding SavePathCommand}"
                            ToolTip="Save the currently edited path" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Validate All"
                            Command="{Binding ValidateAllPathsCommand}"
                            ToolTip="Re-validate every path against the current track (useful after a route changes)" />
                </WrapPanel>
                <TextBox Grid.Row="1"
                         Margin="0,0,0,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search Paths" />
                <ListView Grid.Row="2"
                          ItemsSource="{Binding Paths}"
                          SelectedItem="{Binding SelectedPath, Mode=TwoWay}"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="28" CellTemplate="{StaticResource TrainPathValidityCellTemplate}" />
                            <GridViewColumn Header="Name" Width="320" CellTemplate="{StaticResource TrainPathNameCellTemplate}"
                                            behaviors:GridViewColumnBehavior.StretchColumn="True" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="3"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <DockPanel Grid.Row="3" Margin="0,4,0,0" Grid.RowSpan="2">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,2,0,4"
                               FontWeight="Bold"
                               Text="Path Details" />
                    <ListView ItemsSource="{Binding Metadata}"
                              ItemContainerStyle="{StaticResource TrainPathMetadataRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              behaviors:GridViewColumnBehavior.EqualColumnWidth="True"
                              behaviors:GridViewColumnBehavior.StretchListView="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Setting" Width="250" CellTemplate="{StaticResource TrainPathMetadataNameCellTemplate}" />
                                <GridViewColumn Header="Value" Width="250" CellTemplate="{StaticResource TrainPathMetadataValueCellTemplate}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <TextBlock Grid.Row="5"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessageIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </TabItem>
        <TabItem Header="Path Nodes">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,6">
                    <Button Padding="8,2"
                            Margin="0,0,6,4"
                            Content="Undo"
                            Command="{Binding UndoCommand}" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Redo"
                            Command="{Binding RedoCommand}" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Re-resolve Path"
                            Command="{Binding SnapToTrackCommand}"
                            ToolTip="Rebuild the whole path from its authored nodes using the path resolver. This may insert generated nodes and update links." />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Set Start Here"
                            Command="{Binding SetStartHereCommand}"
                            ToolTip="Choose a track location for the authored start anchor" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Set End Here"
                            Command="{Binding SetEndHereCommand}"
                            ToolTip="Choose a track location for the authored end anchor and resolve the route" />
                    <Button Margin="0,0,6,4"
                             Padding="8,2"
                             Content="Continue Path"
                             Command="{Binding ContinuePathCommand}"
                             ToolTip="Continue building the path by adding route points on the map" />
                    <Button Margin="0,0,6,4"
                             Padding="8,2"
                             Content="Finish Path"
                             Command="{Binding FinishPathCommand}"
                             ToolTip="Finish route building at the last committed route point" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                             Content="Add Route Point"
                            Command="{Binding CommitPlacementCommand}" />
                    <Button Margin="0,0,6,4"
                            Padding="8,2"
                            Content="Cancel Placement"
                            Command="{Binding CancelPlacementCommand}" />
                </WrapPanel>
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Validation}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Valid}" Value="False">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Idx" Width="50" DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding NodeType}" />
                            <GridViewColumn Header="Valid" Width="60" DisplayMemberBinding="{Binding Valid}" />
                            <GridViewColumn Header="Validation" Width="180" DisplayMemberBinding="{Binding Validation}"
                                            behaviors:GridViewColumnBehavior.StretchColumn="True" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,2,0,4"
                               FontWeight="Bold"
                               Text="Path Node Details" />
                    <ListView ItemsSource="{Binding SelectedNodeDetailRows}"
                              ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}"
                              behaviors:GridViewColumnBehavior.EqualColumnWidth="True"
                              behaviors:GridViewColumnBehavior.StretchListView="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="250" CellTemplate="{StaticResource ToolWindowNameCellTemplate}" />
                                <GridViewColumn Header="Value" Width="250" CellTemplate="{StaticResource TrainPathNodeDetailValueCellTemplate}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <TextBlock Grid.Row="4"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessageIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </TabItem>
        <TabItem Header="Diagnostics">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,2,0,4"
                           TextWrapping="Wrap"
                           Text="Select a diagnostic to highlight its affected node or span. Ambiguous routes open their matching route candidates." />
                <Border DockPanel.Dock="Bottom"
                        Margin="0,6,0,0"
                        Padding="6"
                        BorderBrush="Gainsboro"
                        BorderThickness="1">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                HorizontalAlignment="Left"
                                Padding="8,2"
                                Margin="0,6,0,0"
                                Content="Repair Node"
                                Command="{Binding RepairDiagnosticCommand}"
                                ToolTip="Apply the existing safe repair operation to the selected diagnostic node" />
                        <ScrollViewer MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock FontWeight="Bold"
                                           Text="Message" />
                                <TextBlock Margin="0,2,0,6"
                                           Text="{Binding SelectedDiagnostic.Message}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontWeight="Bold"
                                           Text="Suggested Action" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding SelectedDiagnostic.SuggestedAction}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <ListView ItemsSource="{Binding Diagnostics}"
                          SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="{Binding SuggestedAction}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,8,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding Severity}" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Text="{Binding Target}" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,2,0,0"
                                           Text="{Binding Code}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </TabItem>
        <TabItem Header="Route Candidates">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,2,0,4"
                           TextWrapping="Wrap"
                           Text="Spans with several equal-cost routes. Select a candidate to preview it on the map, then accept it to author it as via points." />
                <WrapPanel DockPanel.Dock="Bottom"
                           HorizontalAlignment="Left"
                           Margin="0,6,0,0">
                    <Button Padding="8,2"
                            Margin="0,0,6,4"
                            Content="Accept Candidate"
                            Command="{Binding AcceptRouteCandidateCommand}"
                            ToolTip="Author the selected candidate route as via points, making the span unambiguous" />
                </WrapPanel>
                <ListView ItemsSource="{Binding RouteCandidates}"
                          SelectedItem="{Binding SelectedRouteCandidate, Mode=TwoWay}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,2">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="Nodes " />
                                    <Run Text="{Binding FromNodeIndex, Mode=OneWay}" />
                                    <Run Text="-" />
                                    <Run Text="{Binding ToNodeIndex, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Description, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
