<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.TrainPathToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             xmlns:behaviors="clr-namespace:FreeTrainSimulator.Toolbox.Behaviors"
             xmlns:gt="clr-namespace:GetText.Wpf;assembly=GetText.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrainPathToolWindowViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="520,520"
             d:DesignWidth="520"
             d:DesignHeight="520">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Toolbox;component/Themes/SharedResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="TrainPathMetadataNameCellTemplate">
            <TextBlock Text="{Binding Name}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Padding" Value="4,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Bold}" Value="True">
                                <Setter Property="Padding" Value="0,2,0,2" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!-- The Wait row is the single editor for the wait time used by the map context menu. Other node
             properties remain read-only diagnostic values. -->
        <DataTemplate x:Key="TrainPathNodeDetailValueCellTemplate">
            <Border BorderBrush="Gainsboro"
                    BorderThickness="1,0,0,0"
                    Margin="-6,0,0,0">
                <!-- An empty TextBox otherwise measures to nearly zero width inside a GridView cell, making a
                     normal node's blank Wait value impossible to click. The minimum width gives the value cell
                     a stable property-grid editing surface even before it contains text. -->
                <Grid MinWidth="200">
                    <TextBlock Text="{Binding Value}"
                               Padding="4,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="Wait">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox MinWidth="200"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Padding="4,0"
                             MaxLength="10"
                             PreviewTextInput="WaitTimeTextBox_PreviewTextInput"
                             DataObject.Pasting="WaitTimeTextBox_Pasting"
                             Text="{Binding DataContext.SelectedNodeWaitTime, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Wait time in seconds. Enter a positive value to create or update a wait point; clear the value or enter zero to remove it.">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="Wait">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsRepairMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#FF007ACC" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <!-- Compensate for the focus border so the text does not move when editing. -->
                                        <Setter Property="Padding" Value="3,0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TrainPathMetadataValueCellTemplate">
            <Border BorderBrush="Gainsboro"
                    BorderThickness="1,0,0,0"
                    Margin="-6,0,0,0"
                    Padding="4,0,0,0">
                <TextBlock Text="{Binding Value}"
                           TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <Style x:Key="TrainPathMetadataRowItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource ToolWindowRowItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bold}" Value="True">
                    <Setter Property="Background" Value="#FFEFEFEF" />
                    <Setter Property="Padding" Value="0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TrainPathValidityCellTemplate">
            <TextBlock HorizontalAlignment="Center"
                       FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#x2013;" />
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="ToolTip" Value="Not yet validated" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationState}" Value="Valid">
                                <Setter Property="Text" Value="&#x2713;" />
                                <Setter Property="Foreground" Value="Green" />
                                <Setter Property="ToolTip" Value="Valid: resolves against the current track" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ValidationState}" Value="Invalid">
                                <Setter Property="Text" Value="&#x26A0;" />
                                <Setter Property="Foreground" Value="OrangeRed" />
                                <Setter Property="ToolTip" Value="Invalid: does not resolve against the current track" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TrainPathNodeValidityCellTemplate">
            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" ToolTip="{Binding Validation}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#x2713;" />
                        <Setter Property="Foreground" Value="Green" />
                        <Setter Property="AutomationProperties.Name" Value="{gt:Gettext 'Valid path node'}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Valid}" Value="False">
                                <Setter Property="Text" Value="&#x26A0;" />
                                <Setter Property="Foreground" Value="OrangeRed" />
                                <Setter Property="AutomationProperties.Name" Value="{gt:Gettext 'Invalid path node'}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!-- Bold identifies selection; the trailing asterisk independently identifies unsaved changes. -->
        <DataTemplate x:Key="TrainPathNameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" *"
                           ToolTip="Unsaved changes">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="NewPathButton" Content="New" Command="{Binding NewPathCommand}" Padding="5,2" Margin="0,0,3,0" />
            <Button Content="Save" Command="{Binding SavePathCommand}" Padding="5,2" Margin="0,0,3,0" />
            <Button Content="↶" ToolTip="Undo" AutomationProperties.Name="Undo" Command="{Binding UndoCommand}" Padding="5,2" Margin="0,0,3,0" />
            <Button Content="↷" ToolTip="Redo" AutomationProperties.Name="Redo" Command="{Binding RedoCommand}" Padding="5,2" Margin="0,0,3,0" />
            <Border BorderBrush="Black" BorderThickness="1" SnapsToDevicePixels="True">
            <Menu Background="{Binding Background, ElementName=NewPathButton}">
                <MenuItem Header="Path actions ▾" AutomationProperties.Name="Path actions">
                    <MenuItem x:Name="ReResolvePathMenuItem" Header="Re-resolve path" Command="{Binding SnapToTrackCommand}" />
                    <MenuItem Header="Validate all paths" Command="{Binding ValidateAllPathsCommand}" />
                    <Separator />
                    <MenuItem x:Name="CancelNewPathMenuItem" Header="Cancel new path" Command="{Binding CancelNewPathCommand}" />
                </MenuItem>
            </Menu>
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Repair mode: inspect issues and repair authored nodes. Runtime route rendering is disabled."
                   TextWrapping="Wrap" Background="Moccasin" Foreground="DarkRed"
                   Visibility="{Binding IsRepairMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
        <TextBox Grid.Row="3" Text="{Binding StatusMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 MaxHeight="54" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Command feedback" Margin="0,3,0,0" />
    <TabControl x:Name="PathEditorTabs" Grid.Row="2"
                Margin="0,3,0,0"
                SelectionChanged="PathEditorTabs_SelectionChanged"
                SelectedIndex="{Binding SelectedTabIndex, Mode=OneWay}">
        <TabItem Header="Paths">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView Grid.Row="0"
                          ItemsSource="{Binding Paths}"
                          SelectedItem="{Binding SelectedPath, Mode=OneWay}"
                          PreviewMouseLeftButtonDown="PathList_PreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="PathList_PreviewMouseRightButtonDown"
                          ContextMenuOpening="PathList_ContextMenuOpening"
                          SelectionChanged="PathList_SelectionChanged"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ContextMenu>
                        <ContextMenu />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="28" CellTemplate="{StaticResource TrainPathValidityCellTemplate}" />
                            <GridViewColumn Header="Name" Width="320" CellTemplate="{StaticResource TrainPathNameCellTemplate}"
                                            behaviors:GridViewColumnBehavior.StretchColumn="True">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <views:ColumnFilterHeader Caption="{gt:Gettext 'Name'}" IsSearchable="True"
                                            FilterText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListView}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsFilterRowVisible="{Binding DataContext.IsPathFilterRowVisible, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            ToggleFilterRowCommand="{Binding DataContext.TogglePathFilterRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                    </DataTemplate>
                                </GridViewColumn.HeaderTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <DockPanel Grid.Row="2" Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,2,0,4"
                               FontWeight="Bold"
                               Text="Path Details" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="Name" Margin="4,3,8,3" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="3" AutomationProperties.Name="Path name" GotKeyboardFocus="MetadataEditor_GotKeyboardFocus" LostFocus="MetadataEditor_LostFocus" Text="{Binding PathName, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
                        <TextBlock Grid.Row="1" Text="Start" Margin="4,3,8,3" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="3" AutomationProperties.Name="Path start" GotKeyboardFocus="MetadataEditor_GotKeyboardFocus" LostFocus="MetadataEditor_LostFocus" Text="{Binding PathStart, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
                        <TextBlock Grid.Row="2" Text="End" Margin="4,3,8,3" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="3" AutomationProperties.Name="Path end" GotKeyboardFocus="MetadataEditor_GotKeyboardFocus" LostFocus="MetadataEditor_LostFocus" Text="{Binding PathEnd, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
                        <TextBlock Grid.Row="3" Text="Player Path" Margin="4,3,8,3" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="3" VerticalAlignment="Center" Click="MetadataEditor_Click" IsChecked="{Binding PlayerPath, Mode=TwoWay}" />
                    </Grid>
                    <ListView ItemsSource="{Binding Metadata}"
                              ItemContainerStyle="{StaticResource TrainPathMetadataRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              behaviors:GridViewColumnBehavior.EqualColumnWidth="True"
                              behaviors:GridViewColumnBehavior.StretchListView="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Setting" Width="250" CellTemplate="{StaticResource TrainPathMetadataNameCellTemplate}" />
                                <GridViewColumn Header="Value" Width="250" CellTemplate="{StaticResource TrainPathMetadataValueCellTemplate}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Editor">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <StackPanel Visibility="{Binding IsIdlePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Set start" Command="{Binding SetStartHereCommand}" Padding="6,2" Margin="0,0,4,3" />
                            <Button Content="Set end" Command="{Binding SetEndHereCommand}" Padding="6,2" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsPlacementPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Choose a track location on the map, then confirm placement." TextWrapping="Wrap" />
                        <Button Content="Confirm placement" Command="{Binding CommitPlacementCommand}" />
                        <Button Content="Cancel interaction" Command="{Binding CancelPathInteractionCommand}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsBuildingPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="Add route point" Command="{Binding CommitPlacementCommand}" />
                        <Button Content="Finish path" Command="{Binding FinishPathCommand}" />
                        <Button Content="Cancel interaction" Command="{Binding CancelPathInteractionCommand}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsRejoinPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Select a later main-path node to rejoin the passing branch." TextWrapping="Wrap" />
                        <Button Content="Rejoin at selected node" Command="{Binding CompletePassingBranchCommand}" />
                        <Button Content="Cancel interaction" Command="{Binding CancelPassingBranchCommand}" />
                    </StackPanel>
                    <Grid Visibility="{Binding IsCandidatePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Choose route — selecting a candidate previews it." TextWrapping="Wrap" />
                        <ComboBox Grid.Row="1" ItemsSource="{Binding CandidateSpans}" SelectedItem="{Binding SelectedCandidateSpan, Mode=OneWay}"
                                  SelectionChanged="CandidateSpan_SelectionChanged" AutomationProperties.Name="Route span">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <TextBlock><Run Text="Nodes " /><Run Text="{Binding FromNodeIndex, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding ToNodeIndex, Mode=OneWay}" /></TextBlock>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ListView Grid.Row="2" MaxHeight="90" ItemsSource="{Binding VisibleRouteCandidates}" SelectedItem="{Binding SelectedRouteCandidate, Mode=OneWay}" SelectionChanged="RouteCandidateList_SelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="3" Content="Accept candidate" Command="{Binding AcceptRouteCandidateCommand}" />
                        <Button Grid.Row="4" Content="Cancel interaction" Command="{Binding CancelPathInteractionCommand}" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,3">
                        <Button Content="Continue path" Command="{Binding ContinuePathCommand}" Padding="6,2" Margin="0,0,4,0"
                                Visibility="{Binding IsIdlePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border BorderBrush="Black" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                        <Menu Background="{Binding Background, ElementName=NewPathButton}">
                            <MenuItem Header="{gt:Gettext 'Node actions ▾'}" AutomationProperties.Name="Node actions"
                                      SubmenuOpened="NodeActions_SubmenuOpened">
                                <Separator />
                            </MenuItem>
                        </Menu>
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <ListView Grid.Row="1"
                          ContextMenuOpening="PathNodes_ContextMenuOpening"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=OneWay}"
                          PreviewMouseLeftButtonDown="NodeList_PreviewMouseLeftButtonDown"
                          SelectionChanged="NodeList_SelectionChanged"
                          behaviors:GridViewColumnBehavior.StretchListView="True">
                    <ListView.ContextMenu>
                        <ContextMenu />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding Validation}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Valid}" Value="False">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="28" CellTemplate="{StaticResource TrainPathNodeValidityCellTemplate}" />
                            <GridViewColumn Header="#" Width="44" behaviors:GridViewColumnBehavior.MinimumWidth="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="NodeIndexText" Text="{Binding Index}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Index}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{gt:Gettext 'Type'}" Width="200" behaviors:GridViewColumnBehavior.StretchColumn="True">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding NodeType}" TextWrapping="Wrap" ToolTip="{Binding Validation}" />
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" />
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{gt:Gettext 'Wait (seconds)'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="WaitTimeEditor" Grid.Column="1" MaxLength="10"
                                     IsEnabled="{Binding CanEditSelectedNodeWaitTime}"
                                     Text="{Binding SelectedNodeWaitTime, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                     LostKeyboardFocus="WaitTimeEditor_LostKeyboardFocus" GotKeyboardFocus="WaitTimeEditor_GotKeyboardFocus"
                                     PreviewTextInput="WaitTimeTextBox_PreviewTextInput" DataObject.Pasting="WaitTimeTextBox_Pasting"
                                     AutomationProperties.Name="{gt:Gettext 'Wait time in seconds'}" />
                            <Button Grid.Column="2" Content="{gt:Gettext 'Clear Wait Point'}" Command="{Binding ClearWaitPointCommand}"
                                    Margin="6,0,0,0" AutomationProperties.Name="{gt:Gettext 'Clear Wait Point'}"
                                    ToolTip="{gt:Gettext 'Remove wait flags and wait data from the selected node.'}" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedNode.Validation}" TextWrapping="Wrap" />
                        <Expander Header="{gt:Gettext 'Details'}" IsExpanded="True">
                            <Border BorderBrush="DarkGray" BorderThickness="1" SnapsToDevicePixels="True" Margin="0,4,0,0">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <Border BorderBrush="Gainsboro" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="NodeDetailNames" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <GridViewColumnHeader Content="{gt:Gettext 'Name'}" IsHitTestVisible="False" Focusable="False" />
                                        <GridViewColumnHeader Grid.Column="1" Content="{gt:Gettext 'Value'}" IsHitTestVisible="False" Focusable="False" />
                                    </Grid>
                                </Border>
                            <ItemsControl ItemsSource="{Binding SelectedNodeDetailRows}"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="Gainsboro" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="NodeDetailNames" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="155" Padding="4,3" />
                                            <Border Grid.Column="1" BorderBrush="Gainsboro" BorderThickness="1,0,0,0" Padding="4,3">
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </Border>
                        </Expander>
                <Expander x:Name="IssuesExpander" Margin="0,6,0,0" IsExpanded="{Binding IsIssuesExpanded, Mode=TwoWay}">
                    <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Issues" /><TextBlock Text="{Binding VisibleDiagnostics.Count, StringFormat= ({0})}" /></StackPanel></Expander.Header>
            <StackPanel>
                <ListView x:Name="DiagnosticList" ItemsSource="{Binding VisibleDiagnostics}"
                          SelectedItem="{Binding SelectedDiagnostic, Mode=OneWay}"
                          SelectionChanged="DiagnosticList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="120" Margin="0,4,0,0" AutomationProperties.Name="Path issues">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="{Binding SuggestedAction}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,2">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Severity, Mode=OneWay}" />
                                    <Run Text="{Binding Target, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Code}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Padding="6" Margin="0,6,0,0" BorderBrush="Gainsboro" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDiagnostic}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                <StackPanel>
                    <TextBlock FontWeight="Bold"
                               Text="{gt:Gettext 'Message'}" />
                    <TextBlock Margin="0,2,0,6"
                               Text="{Binding SelectedDiagnostic.Message}"
                               TextWrapping="Wrap" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDiagnostic.SuggestedAction}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedDiagnostic.SuggestedAction}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    <TextBlock FontWeight="Bold"
                               Text="{gt:Gettext 'Suggested Action'}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding SelectedDiagnostic.SuggestedAction}"
                               TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="{gt:Gettext 'Repair node'}" Command="{Binding RepairDiagnosticCommand}"
                            HorizontalAlignment="Left" Margin="0,6,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDiagnostic.CanRepair}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </Border>
            </StackPanel>
                </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</UserControl>
