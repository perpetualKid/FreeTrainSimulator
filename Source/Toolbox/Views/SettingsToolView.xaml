<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.SettingsToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsToolWindowViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="480,560"
             d:DesignWidth="480"
             d:DesignHeight="560">
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button HorizontalAlignment="Right"
                    Padding="10,3"
                    Content="Reset to Defaults"
                    ToolTip="Reset window layout, colors, item visibility, and appearance options to their defaults"
                    Command="{Binding ResetCommand}" />
        </Border>
        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6">
                        <GroupBox Header="Common" Padding="6" Margin="0,0,0,6">
                            <StackPanel>
                                <CheckBox Content="Enable Logging"
                                          Margin="0,3"
                                          IsChecked="{Binding EnableLogging}" />
                                <CheckBox Content="Restore Last View on Start"
                                          Margin="0,3"
                                          IsChecked="{Binding RestoreLastView}" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Language"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="Select the user interface language" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Graphics" Padding="6">
                            <StackPanel>
                                <CheckBox Content="Use Font Outline"
                                          Margin="0,3"
                                          IsChecked="{Binding FontOutline}" />
                                <CheckBox Content="Use Real Track Width"
                                          Margin="0,3"
                                          IsChecked="{Binding RealTrackWidth}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Colors">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ColorItems}" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableColorNames}"
                                              SelectedItem="{Binding SelectedColorName}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="14"
                                                               Height="14"
                                                               Margin="0,0,6,0"
                                                               Stroke="Gray"
                                                               StrokeThickness="1"
                                                               Fill="{Binding Converter={StaticResource ColorNameToBrushConverter}}" />
                                                    <TextBlock Text="{Binding}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Item Visibility">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6">
                        <Expander Header="Track Items" IsExpanded="True" Margin="0,2">
                            <ItemsControl ItemsSource="{Binding TrackVisibilityItems}" Margin="12,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  Margin="0,2"
                                                  IsChecked="{Binding IsVisible}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="Road Items" IsExpanded="True" Margin="0,2">
                            <ItemsControl ItemsSource="{Binding RoadVisibilityItems}" Margin="12,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  Margin="0,2"
                                                  IsChecked="{Binding IsVisible}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="Interactives" IsExpanded="True" Margin="0,2">
                            <ItemsControl ItemsSource="{Binding InteractiveVisibilityItems}" Margin="12,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  Margin="0,2"
                                                  IsChecked="{Binding IsVisible}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <ItemsControl ItemsSource="{Binding OtherVisibilityItems}" Margin="0,3,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              Margin="0,2"
                                              IsChecked="{Binding IsVisible}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
