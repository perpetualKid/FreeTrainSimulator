<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.TrackItemInfoToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrackItemInfoToolWindowViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="520,480"
             d:DesignWidth="520"
             d:DesignHeight="480">
    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    Padding="8,0"
                    Content="Find"
                    Command="{Binding SearchCommand}" />
            <TextBox VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Find Track Item by Index">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <ListView ItemsSource="{Binding Rows}"
                  ItemContainerStyle="{StaticResource ToolWindowRowItemStyle}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Value" Width="320" DisplayMemberBinding="{Binding Value}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
