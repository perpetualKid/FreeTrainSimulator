<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.RouteToolView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels"
             xmlns:views="clr-namespace:FreeTrainSimulator.Toolbox.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolboxMenuViewModel, IsDesignTimeCreatable=False}"
             views:ToolWindow.DefaultFloatingSize="360,420"
             d:DesignWidth="360"
             d:DesignHeight="420">
    <DockPanel Margin="12"
               IsEnabled="{Binding Enabled}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Content Folder"
                       Margin="0,0,0,3" />
            <ComboBox Margin="0,0,0,9"
                      ItemsSource="{Binding ContentFolders}"
                      SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      ToolTip="Select the content folder to load routes from" />
            <TextBlock Text="Route"
                       Margin="0,0,0,3" />
            <ComboBox ItemsSource="{Binding Routes}"
                      SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      ToolTip="Select a route to open" />
            <TextBlock x:Name="RouteStatusMessage"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,9,0,0" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="RouteErrorDetails"
                       Text="{Binding Error}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,6,0,0" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <TextBox Text="{Binding SelectedRoute.Description, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="Description of the selected route"
                 Margin="0,12,0,0" />
    </DockPanel>
</UserControl>
