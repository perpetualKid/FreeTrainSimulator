<UserControl x:Class="FreeTrainSimulator.Toolbox.Views.ColumnFilterHeader"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gt="clr-namespace:GetText.Wpf;assembly=GetText.Wpf"
             x:Name="HeaderControl">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid MinHeight="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CaptionLabel" Text="{Binding Caption, ElementName=HeaderControl}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="FilterToggle" Grid.Column="1" Padding="3,0" Margin="4,0,0,0"
                    Background="Transparent" BorderThickness="0" Click="FilterToggle_Click"
                    Command="{Binding ToggleFilterRowCommand, ElementName=HeaderControl}"
                    Visibility="{Binding IsSearchable, ElementName=HeaderControl, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{gt:Gettext 'Toggle column filter'}"
                    AutomationProperties.LabeledBy="{Binding ElementName=CaptionLabel}"
                    ToolTip="{gt:Gettext 'Toggle column filter'}">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" />
            </Button>
        </Grid>
        <!-- Nonsearchable columns reserve the same lower-row height without owning a filter. -->
        <Grid Grid.Row="1" Height="26"
              Visibility="{Binding IsFilterRowVisible, ElementName=HeaderControl, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Visibility="{Binding IsSearchable, ElementName=HeaderControl, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterEditor" MinWidth="0" VerticalContentAlignment="Center"
                         Text="{Binding FilterText, ElementName=HeaderControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{gt:Gettext 'Column filter'}"
                         AutomationProperties.LabeledBy="{Binding ElementName=CaptionLabel}"
                         ToolTip="{gt:Gettext 'Column filter'}" />
                <Button Grid.Column="1" Padding="3,0" Click="ClearFilter_Click"
                        AutomationProperties.Name="{gt:Gettext 'Clear column filter'}"
                        AutomationProperties.LabeledBy="{Binding ElementName=CaptionLabel}"
                        ToolTip="{gt:Gettext 'Clear column filter'}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
