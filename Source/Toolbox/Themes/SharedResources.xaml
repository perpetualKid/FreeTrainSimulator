<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:FreeTrainSimulator.Toolbox.ViewModels">
    <!-- Shared converters and styles merged by the shell and tool-window views that use them. -->
    <viewModels:DrawingColorToBrushConverter x:Key="DrawingColorToBrushConverter" />
    <viewModels:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    <viewModels:ColorNameToBrushConverter x:Key="ColorNameToBrushConverter" />
    <viewModels:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <Style x:Key="ToolWindowToolbarBandStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style x:Key="ToolWindowToolbarTrayStyle" TargetType="ToolBarTray">
        <Setter Property="IsLocked" Value="True" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
    </Style>
    <Style x:Key="ToolWindowToolbarStyle" TargetType="ToolBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="ToolWindowToolbarIconButtonStyle" TargetType="Button"
           BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style x:Key="ToolWindowSelectedPrimaryTextStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="ToolWindowPrimaryNameCellTemplate">
        <TextBlock Text="{Binding Name}" Style="{StaticResource ToolWindowSelectedPrimaryTextStyle}" />
    </DataTemplate>
    <DataTemplate x:Key="ToolWindowNameCellTemplate">
        <TextBlock Text="{Binding Name}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ToolWindowSelectedPrimaryTextStyle}">
                    <Setter Property="Padding" Value="4,0,0,0" />
                    <Style.Triggers>
                        <!-- Section headings retain their emphasis whether or not they are selected. -->
                        <DataTrigger Binding="{Binding Bold}" Value="True">
                            <Setter Property="Padding" Value="0,0,0,0" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="ToolWindowValueCellTemplate">
        <Border BorderBrush="Gainsboro"
                BorderThickness="1,0,0,0"
                Margin="-6,0,0,0"
                Padding="4,0,0,0">
            <TextBlock Text="{Binding Value}" />
        </Border>
    </DataTemplate>
    <Style x:Key="ToolWindowRowItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground"
                Value="{Binding Color, Converter={StaticResource DrawingColorToBrushConverter}}" />
        <Setter Property="FontWeight"
                Value="{Binding Bold, Converter={StaticResource BoolToFontWeightConverter}}" />
        <Setter Property="BorderBrush" Value="Gainsboro" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,1" />
    </Style>
</ResourceDictionary>
