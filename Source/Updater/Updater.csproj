<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Free Train Simulator Updater</Description>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>Free Train Simulator Updater</AssemblyTitle>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <OutputPath>..\..\Program</OutputPath>
    <RootNamespace>FreeTrainSimulator.Updater</RootNamespace>
    <ApplicationIcon>..\FTS.ico</ApplicationIcon>
    <Configurations>Debug;Release;CodeAnalysis;UpdateContentVersion</Configurations>
		<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GetText.NET" Version="10.0.1" />
    <PackageReference Include="GetText.NET.WindowsForms" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FreeTrainSimulator.Updater\FreeTrainSimulator.Updater.csproj" />
  </ItemGroup>
</Project>